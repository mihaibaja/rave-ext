{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAVE Profiler JSON Schema",
  "version": "1.0.0",
  "description": "Esquema del JSON de contadores por region que genera RAVE (RAVE_PRINT_JSON / rave --json) y que consume el visor ../profiler/. El contrato campo a campo esta documentado en docs/PROFILER_JSON_API.md; este fichero es su version legible por maquina. Notas: (1) el documento NO lleva campo de version, `generator` identifica quien lo escribio; (2) los recuentos se emiten con %.0f, por eso son `integer`, mientras que las medias/ratios se emiten como `number` (un real entero sale sin parte decimal, p. ej. \"avg_lmul\": 1); (3) `binary`, `name` y `parent` pueden ser null; (4) other.instr/other.elems pueden ser NEGATIVOS porque `other` es un residuo (ver docs/PROFILER_JSON_API.md 1.5); (5) additionalProperties=false a proposito: el objetivo del esquema es detectar campos nuevos o desaparecidos (p. ej. indexed_ordered/indexed_unordered).",
  "type": "object",
  "required": [
    "generator",
    "binary",
    "vlen_bits",
    "trace_extended",
    "accumulate_regions",
    "region_count",
    "regions"
  ],
  "additionalProperties": false,
  "properties": {
    "generator": {
      "type": "string",
      "minLength": 1,
      "description": "Quien genero el fichero (actualmente \"RAVE\")."
    },
    "binary": {
      "type": ["string", "null"],
      "description": "Ruta del binario medido, tal como se paso en la linea de ordenes."
    },
    "vlen_bits": {
      "type": "integer",
      "minimum": 0,
      "description": "VLEN en bits con la que se midio."
    },
    "trace_extended": {
      "type": "boolean",
      "description": "Si se tomaron las metricas extendidas (RAVE_TRACE_EXTENDED)."
    },
    "accumulate_regions": {
      "type": "boolean",
      "description": "Si los contadores de cada region son la media por ejecucion en vez del delta de la ultima."
    },
    "region_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Numero de regiones EJECUTADAS. No coincide con len(regions) cuando accumulate_regions es true."
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": [
        "id",
        "name",
        "nesting",
        "rank",
        "thread",
        "executions",
        "parent",
        "counters"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "description": "Indice de region (orden de creacion dentro del fichero)."
        },
        "name": {
          "type": ["string", "null"],
          "description": "Nombre de la region; \"GLOBAL_REGION\" si el binario no abre regiones explicitas."
        },
        "nesting": {
          "type": "integer",
          "minimum": 0,
          "description": "Profundidad de anidamiento (0 = raiz)."
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "description": "Rank MPI."
        },
        "thread": {
          "type": "integer",
          "minimum": 0,
          "description": "Hilo que abrio la region."
        },
        "executions": {
          "type": "integer",
          "minimum": 0,
          "description": "Veces que se ejecuto la region (1 sin acumulacion, N con RAVE_ACCUM_REGIONS)."
        },
        "parent": {
          "type": ["string", "null"],
          "description": "Nombre de la region padre, o null si es raiz."
        },
        "counters": { "$ref": "#/$defs/counters" }
      }
    },

    "counters": {
      "type": "object",
      "required": ["moved_bytes", "flops", "global_stats", "dependencies", "instructions"],
      "additionalProperties": false,
      "properties": {
        "moved_bytes": { "$ref": "#/$defs/triple" },
        "flops": { "$ref": "#/$defs/triple" },
        "global_stats": { "$ref": "#/$defs/globalStats" },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "instructions": { "$ref": "#/$defs/instructions" }
      }
    },

    "triple": {
      "type": "object",
      "description": "Desglose escalar/vectorial de una magnitud (bytes o FLOPs). total = scalar + vector.",
      "required": ["total", "scalar", "vector"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number" },
        "scalar": { "type": "number" },
        "vector": { "type": "number" }
      }
    },

    "globalStats": {
      "type": "object",
      "required": [
        "avg_vl_elems",
        "avg_vl_bits",
        "avg_lmul",
        "avg_occupancy",
        "vlen_bits",
        "avg_vlmax_elems",
        "tu_effective",
        "ta_effective",
        "unique_vector_registers"
      ],
      "additionalProperties": false,
      "properties": {
        "avg_vl_elems": {
          "type": "number",
          "minimum": 0,
          "description": "Media de VL (elementos) sobre las instrucciones vectoriales."
        },
        "avg_vl_bits": {
          "type": "number",
          "minimum": 0,
          "description": "Media de min(VL*SEW, VLEN*LMUL) en bits."
        },
        "avg_lmul": {
          "type": "number",
          "minimum": 0,
          "description": "Media de LMUL (1/8 ... 8)."
        },
        "avg_occupancy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Media de min(VL*SEW, VLEN*LMUL)/(VLEN*LMUL); 1.0 = datapath lleno."
        },
        "vlen_bits": { "type": "integer", "minimum": 0 },
        "avg_vlmax_elems": { "type": "number", "minimum": 0 },
        "tu_effective": {
          "type": "integer",
          "minimum": 0,
          "description": "Instrucciones con VL efectiva < VLMAX y politica tail-undisturbed."
        },
        "ta_effective": {
          "type": "integer",
          "minimum": 0,
          "description": "Idem con politica tail-agnostic."
        },
        "unique_vector_registers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "description": "Registros vectoriales distintos usados."
        }
      }
    },

    "dependencies": {
      "type": "object",
      "required": ["scalar", "vector"],
      "additionalProperties": false,
      "properties": {
        "scalar": {
          "type": "object",
          "description": "Riesgos entre registros escalares. total = raw + waw + war.",
          "required": ["total", "raw", "waw", "war"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "raw": { "type": "integer", "minimum": 0 },
            "waw": { "type": "integer", "minimum": 0 },
            "war": { "type": "integer", "minimum": 0 }
          }
        },
        "vector": {
          "type": "object",
          "description": "Riesgos con registros vectoriales. total = raw.count + waw.count + war.count.",
          "required": ["total", "raw", "waw", "war"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "raw": { "$ref": "#/$defs/depVector" },
            "waw": { "$ref": "#/$defs/depVector" },
            "war": { "$ref": "#/$defs/depVector" }
          }
        }
      }
    },

    "depVector": {
      "type": "object",
      "required": ["count", "avg_dist"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "avg_dist": {
          "type": "number",
          "minimum": 0,
          "description": "Distancia media en instrucciones. Si count = 0 vale 0 (no es un error)."
        }
      }
    },

    "instructions": {
      "type": "object",
      "description": "total = scalar + vsetvl + vector, y vector = suma de sew[i].instr.",
      "required": ["total", "scalar", "vsetvl", "vector", "sew"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "scalar": { "type": "integer", "minimum": 0 },
        "vsetvl": { "type": "integer", "minimum": 0 },
        "vector": { "type": "integer", "minimum": 0 },
        "sew": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "Siempre 4 bloques (SEW 8/16/32/64), aunque esten a cero. Usa el campo sew de cada bloque, no la posicion.",
          "items": { "$ref": "#/$defs/sewBlock" }
        }
      }
    },

    "sewBlock": {
      "type": "object",
      "required": ["sew", "instr", "elems", "avg_vl", "arith", "memory", "reduction", "mask", "other"],
      "additionalProperties": false,
      "properties": {
        "sew": {
          "type": "integer",
          "enum": [8, 16, 32, 64]
        },
        "instr": { "type": "integer", "minimum": 0 },
        "elems": { "type": "integer", "minimum": 0 },
        "avg_vl": { "type": "number", "minimum": 0 },
        "arith": { "$ref": "#/$defs/arith" },
        "memory": { "$ref": "#/$defs/memory" },
        "reduction": { "$ref": "#/$defs/countTriple" },
        "mask": { "$ref": "#/$defs/instrElemsAvgVl" },
        "other": {
          "allOf": [{ "$ref": "#/$defs/instrElemsAvgVl" }],
          "description": "Residuo, NO una categoria: instr = instr - memory.instr - arith.instr - reduction.instr - mask.instr. Puede ser NEGATIVO (ver docs/PROFILER_JSON_API.md 1.5)."
        }
      }
    },

    "instrElemsAvgVl": {
      "type": "object",
      "required": ["instr", "elems", "avg_vl"],
      "additionalProperties": false,
      "properties": {
        "instr": { "type": "integer" },
        "elems": { "type": "integer" },
        "avg_vl": { "type": "number" }
      }
    },

    "countTriple": {
      "type": "object",
      "description": "total = fp + int.",
      "required": ["instr", "elems", "fp", "int"],
      "additionalProperties": false,
      "properties": {
        "instr": { "type": "integer", "minimum": 0 },
        "elems": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "int": { "type": "integer", "minimum": 0 }
      }
    },

    "arith": {
      "type": "object",
      "description": "Aritmetica vectorial. Dos ejes solapados: forma (narrowing + widening + normal = instr) y funcion (permutations, mask, reductions, computation y scalar_deps son SUBCONJUNTOS de instr; no los sumes con la forma).",
      "required": [
        "instr",
        "elems",
        "avg_vl",
        "fp",
        "int",
        "narrowing",
        "widening",
        "widening_reductions",
        "widening_fused",
        "normal",
        "permutations",
        "mask",
        "reductions",
        "computation",
        "scalar_deps"
      ],
      "additionalProperties": false,
      "properties": {
        "instr": { "type": "integer", "minimum": 0 },
        "elems": { "type": "integer", "minimum": 0 },
        "avg_vl": { "type": "number", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "int": { "type": "integer", "minimum": 0 },
        "narrowing": { "type": "integer", "minimum": 0 },
        "widening": { "type": "integer", "minimum": 0 },
        "widening_reductions": { "$ref": "#/$defs/fpIntPair" },
        "widening_fused": { "type": "integer", "minimum": 0 },
        "normal": { "type": "integer", "minimum": 0 },
        "permutations": { "$ref": "#/$defs/permutations" },
        "mask": {
          "type": "integer",
          "minimum": 0,
          "description": "Valor duplicado con sew[s].mask.instr (mismo contador interno, vmask_instr)."
        },
        "reductions": { "$ref": "#/$defs/fpIntPair" },
        "computation": {
          "type": "object",
          "required": ["total", "fused"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "fused": { "type": "integer", "minimum": 0 }
          }
        },
        "scalar_deps": {
          "type": "object",
          "required": ["total", "read_from_scalar", "write_to_scalar"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "read_from_scalar": { "type": "integer", "minimum": 0 },
            "write_to_scalar": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "fpIntPair": {
      "type": "object",
      "description": "total = fp + int.",
      "required": ["total", "fp", "int"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "int": { "type": "integer", "minimum": 0 }
      }
    },

    "permutations": {
      "type": "object",
      "required": ["total", "moves", "slides", "gather", "compress"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "moves": {
          "type": "object",
          "required": ["total", "read_from_scalar", "write_to_scalar", "whole_register", "others"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "read_from_scalar": { "type": "integer", "minimum": 0 },
            "write_to_scalar": { "type": "integer", "minimum": 0 },
            "whole_register": { "type": "integer", "minimum": 0 },
            "others": { "type": "integer", "minimum": 0 }
          }
        },
        "slides": { "type": "integer", "minimum": 0 },
        "gather": { "type": "integer", "minimum": 0 },
        "compress": { "type": "integer", "minimum": 0 }
      }
    },

    "memory": {
      "type": "object",
      "description": "Accesos a memoria. instr = unit + strided + indexed + whole_register (categorias excluyentes); segmented_unit/segmented_strided/segmented_indexed son SUBCONJUNTOS de su categoria (solo con traza extendida); indexed = indexed_ordered + indexed_unordered.",
      "required": [
        "instr",
        "elems",
        "avg_vl",
        "unit",
        "segmented_unit",
        "strided",
        "avg_stride_b",
        "stddev_stride_b",
        "segmented_strided",
        "indexed",
        "segmented_indexed",
        "whole_register"
      ],
      "additionalProperties": false,
      "properties": {
        "instr": { "type": "integer", "minimum": 0 },
        "elems": { "type": "integer", "minimum": 0 },
        "avg_vl": { "type": "number", "minimum": 0 },
        "unit": { "type": "integer", "minimum": 0 },
        "segmented_unit": { "type": "integer", "minimum": 0 },
        "strided": { "type": "integer", "minimum": 0 },
        "avg_stride_b": {
          "type": "number",
          "description": "Stride medio en BYTES; 0 si no hay accesos strided."
        },
        "stddev_stride_b": {
          "type": "number",
          "minimum": 0,
          "description": "Desviacion tipica del stride en BYTES; 0 si no hay accesos strided."
        },
        "segmented_strided": { "type": "integer", "minimum": 0 },
        "indexed": { "type": "integer", "minimum": 0 },
        "indexed_ordered": {
          "type": "integer",
          "minimum": 0,
          "description": "Subconjunto de indexed (vle.v/vse.v indexado ordered). Añadido el 2026-10-12: los ficheros generados antes de esa fecha no lo traen (leelo como 0)."
        },
        "indexed_unordered": {
          "type": "integer",
          "minimum": 0,
          "description": "Subconjunto de indexed (indexed unordered). Añadido el 2026-10-12: los ficheros generados antes de esa fecha no lo traen (leelo como 0)."
        },
        "segmented_indexed": { "type": "integer", "minimum": 0 },
        "whole_register": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
